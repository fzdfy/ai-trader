{
  "name": "ai-trader",
  "private": true,
  "scripts": {
    "dev": "dotenvx run -f .env.local -- turbo dev & pnpm run quant:dev",
    "build": "dotenvx run -f .env.local -- turbo build",
    "build:web": "dotenvx run -f .env.local -- turbo build --filter=@ai-trader/web",
    "start": "dotenvx run -f .env.local -- turbo start",
    "start:server": "dotenvx run -f .env.local -- turbo start --filter @ai-trader/server",
    "lint": "oxlint . && turbo lint",
    "format": "oxfmt",
    "check-types": "turbo check-types",
    "db:push": "turbo db:push",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio",
    "sync-instruments": "node --import @oxc-node/core/register --env-file=.env.local apps/server/scripts/sync-instruments.ts",
    "sync-kline1d": "node --import @oxc-node/core/register --env-file=.env.local apps/server/scripts/sync-kline1d.ts",
    "sync-kline-period": "node --import @oxc-node/core/register --env-file=.env.local apps/server/scripts/sync-kline-period.ts",
    "sync-news": "node --import @oxc-node/core/register --env-file=.env.local apps/server/scripts/sync-news.ts",
    "worker:sync": "dotenvx run -f .env.local -- pnpm --filter @ai-trader/server run worker:sync",
    "quant:dev": "cd apps/quant && uv run uvicorn main:app --host 0.0.0.0 --port 3002 --reload",
    "quant:start": "cd apps/quant && uv run uvicorn main:app --host 0.0.0.0 --port 3002"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.1.21",
    "stock-sdk": "^2.4.2"
  },
  "devDependencies": {
    "@ai-trader/eslint-config": "workspace:*",
    "@astryxdesign/cli": "^0.1.5",
    "@dotenvx/dotenvx": "^2.15.1",
    "@oxc-node/core": "^0.1.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^22.10.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.17.0",
    "oxlint": "^0.15.10",
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}