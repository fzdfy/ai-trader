{
  "extends": "@total-typescript/tsconfig/bundler/no-dom/app",
  "include": ["src", "test"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
  },
}
