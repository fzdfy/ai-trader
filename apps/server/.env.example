# === 数据库 ===
# 本地开发:       postgres://ai-trader:aitrader123@localhost:5432/aitrader
# Docker Compose: postgres://ai-trader:aitrader123@postgres:5432/aitrader（容器内自动覆盖）
DATABASE_URL=postgres://ai-trader:aitrader123@localhost:5432/aitrader

# === Better Auth ===
BETTER_AUTH_SECRET=replace-with-a-random-64-char-string
# 本地开发: http://localhost:5173
# Docker:    http://localhost:80（容器内自动覆盖）
BETTER_AUTH_URL=http://localhost:5173

# === AI Agent（DeepSeek，也支持其他 OpenAI 兼容提供商）===
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# === 回测微服务 ===
# 本地开发: http://localhost:3002
# Docker:    http://quant:3002（容器内自动覆盖）
QUANT_URL=http://localhost:3002
