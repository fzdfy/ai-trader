{
  "name": "@ai-trader/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @oxc-node/core/register --watch ./src/main.ts",
    "start": "node --import @oxc-node/core/register ./src/main.ts",
    "test": "node --import @oxc-node/core/register --test \"src/**/*.test.ts\"",
    "test:db": "node --import @oxc-node/core/register --test --test-concurrency=1 src/db/workflow-schema.test.ts src/services/workflow-service.integration.ts src/workers/workflow-worker.integration.ts",
    "check-types": "tsgo -b --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push --verbose",
    "sync:instruments": "node --import @oxc-node/core/register scripts/sync-instruments.ts",
    "sync:boards": "node --import @oxc-node/core/register scripts/sync-boards.ts",
    "sync:board-kline": "node --import @oxc-node/core/register scripts/sync-board-kline.ts",
    "sync:fundflow": "node --import @oxc-node/core/register scripts/sync-fundflow.ts",
    "sync:limit-up-pool": "node --import @oxc-node/core/register scripts/sync-limit-up-pool.ts",
    "sync:calendar": "node --import @oxc-node/core/register scripts/sync-calendar.ts",
    "sync:adj-factor": "node --import @oxc-node/core/register scripts/sync-adj-factor.ts",
    "refresh:kline1d": "node --import @oxc-node/core/register scripts/refresh-kline1d.ts",
    "backfill:kline1d": "node --import @oxc-node/core/register scripts/backfill-kline1d.ts",
    "backfill:constituent-symbol": "node --import @oxc-node/core/register scripts/backfill-constituent-symbol.ts",
    "verify:route-a": "node --import @oxc-node/core/register scripts/verify-route-a.ts",
    "eval:research-rag": "node --import @oxc-node/core/register scripts/evaluate-research-rag.ts",
    "governance:check": "node --env-file-if-exists=../../.env.local --import @oxc-node/core/register scripts/check-governance.ts",
    "sync:kline": "node --import @oxc-node/core/register scripts/sync-kline.ts",
    "worker:sync": "node --import @oxc-node/core/register src/workers/sync-worker/index.ts",
    "worker:research": "node --import @oxc-node/core/register src/workers/research-worker/index.ts",
    "worker:workflow": "node --import @oxc-node/core/register src/workers/workflow-worker/index.ts",
    "worker:feature": "node --import @oxc-node/core/register src/workers/feature-worker/index.ts",
    "worker:kline": "node --import @oxc-node/core/register src/workers/kline-worker/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@mastra/ai-sdk": "^1.7.2",
    "@mastra/core": "^1.57.0",
    "@mastra/memory": "^1.26.0",
    "@mastra/pg": "^1.19.0",
    "ai": "^7.0.58",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.18",
    "mastra": "^1.23.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.7",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.4"
  }
}
